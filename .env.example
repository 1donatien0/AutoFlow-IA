# ============================================================================
# AutoFlow AI — configuration (copier en .env à la racine : cp .env.example .env)
# ============================================================================

# development | test | production
# En production, l'API refuse de démarrer avec des secrets par défaut.
ENVIRONMENT=development

# --- Base de données (SQLite en dev — PostgreSQL via Docker / en prod)
DATABASE_URL=sqlite+aiosqlite:///./autoflow.db
DATABASE_URL_SYNC=sqlite:///./autoflow.db
# DATABASE_URL=postgresql+asyncpg://autoflow:autoflow@localhost:5432/autoflow
# DATABASE_URL_SYNC=postgresql+psycopg://autoflow:autoflow@localhost:5432/autoflow
# true = tables créées au démarrage (dev). En prod : false + `alembic upgrade head`
AUTO_CREATE_TABLES=true

# Identifiants PostgreSQL utilisés par docker-compose
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=autoflow
POSTGRES_DB=autoflow

# --- Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# local = exécution dans l'API (aucun Redis requis) | celery = worker dédié
WORKFLOW_EXECUTOR=local

# --- Secrets (générer avec : openssl rand -hex 32)
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Clé Fernet optionnelle pour chiffrer les jetons OAuth (sinon dérivée de API_SECRET_KEY)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- URLs
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# --- Anti brute-force sur /auth/login
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- Google OAuth (Gmail lecture seule)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Microsoft OAuth (Outlook lecture seule)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback
MICROSOFT_TENANT_ID=common

# --- LLM (optionnel — heuristiques si vide)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Produit
OBSERVATION_ONLY=true
# Données de démonstration + connexion OAuth simulée (désactiver en production)
DEMO_MODE=true
# Rétention RGPD des emails observés (purge quotidienne par le worker Celery)
DATA_RETENTION_DAYS=90

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
